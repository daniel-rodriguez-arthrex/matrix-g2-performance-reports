# Matrix G2 Performance Test - environment configuration.
# Copy this file to `.env` (which is gitignored) and fill in real values.
# NEVER commit real credentials, internal IPs, or passcodes to source control.

# --- Option A: multi-room config as a single JSON object (recommended) ---
# Keeps all credentials and internal IPs out of tracked source.
# MATRIX_ROOMS_JSON={"OR1":{"base_url":"https://<room-ip>:10001","username":"admin","password":"<password>","passcode":"<passcode>"},"OR2":{"base_url":"http://<room-ip>:10001","username":"admin","password":"<password>"}}

# --- Option B: single-room config via discrete vars ---
MATRIX_BASE_URL=https://<room-ip>:10001
MATRIX_USERNAME=admin
MATRIX_PASSWORD=<password>
MATRIX_PASSCODE=<passcode>

# Which room to target by default
ROOM_ID=OR1

# Runtime options
HEADLESS=true
OUTPUT_DIR=results
